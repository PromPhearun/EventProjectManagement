# AI Studio Applet Configuration
# Define all required environment variables here.
# The platform will prompt the user to provide values for these secrets.

# Google OAuth Credentials
# Obtain these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret key for session encryption
SESSION_SECRET=

# Shared App URL (provided by the platform in runtime context)
APP_URL=

# Firebase Client Configuration (Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin (Server-side Webhooks)
# This should be the full JSON string of your service account key
FIREBASE_SERVICE_ACCOUNT_JSON=
